{
  "name": "dsh-status-anim",
  "version": "0.3.0",
  "description": "在 DSH Web GUI 的「Deep diving...」状态提示条上插入用户自定义动图（APNG/WebP/PNG）；放文件即换图，零重建零重启",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/*.webp",
    "assets/NOTICE.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "status-anim",
    "animation"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Mr-cjf/dsh-status-anim.git" },
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "node scripts/check-release.mjs"
  }
}
